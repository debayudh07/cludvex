# --- required ---------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
# Paste the service-account JSON on one line, or set GOOGLE_APPLICATION_CREDENTIALS
# to a file path instead. Needs: Cloud Datastore User + Firebase Cloud Messaging Admin.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Google AI Studio -> API keys (starts with AIza...)
GEMINI_API_KEY=

# --- optional ---------------------------------------------------------------
# Cloud Firestore is the default. Uncomment (and use
# `docker compose --profile emulator up`) to run against the emulator
# instead -- offline and free, but it auto-creates indexes, so it hides
# missing-index failures that cloud would surface.
# FIRESTORE_EMULATOR_HOST=firestore:8081
TRIAGE_MODEL=gemini-3.8-flash
VERIFIER_MODEL=gemini-3.8-flash
RENDER_API_BASE=https://api.render.com/v1
# v1 is notify-only. true enables user-tapped Restart (still audit-logged).
ACTIONS_ENABLED=false
WATCH_POLL_SECONDS=60
GROUP_WINDOW_SECONDS=600
RESOLVE_AFTER_MINUTES=30
MAX_WATCHED_SERVICES=3
DEFAULT_CONFIDENCE_GATE=75
DEFAULT_MAX_ALERTS_PER_HOUR=6
# Run the watcher inside the API process (free hosting, e.g. Render free web
# service). Leave false when the watcher runs as its own process.
RUN_WATCHER_IN_API=false
LOG_LEVEL=INFO
ENV=development
