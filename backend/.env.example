# --- required ---------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
# Paste the service-account JSON on one line, or set GOOGLE_APPLICATION_CREDENTIALS
# to a file path instead. Needs: Cloud Datastore User + Firebase Cloud Messaging Admin.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Google AI Studio -> API keys (starts with AIza...)
GEMINI_API_KEY=

# --- optional ---------------------------------------------------------------
# Local dev only (docker-compose sets this for you).
# FIRESTORE_EMULATOR_HOST=localhost:8081
TRIAGE_MODEL=gemini-flash-latest
VERIFIER_MODEL=gemini-pro-latest
RENDER_API_BASE=https://api.render.com/v1
# v1 is notify-only. true enables user-tapped Restart (still audit-logged).
ACTIONS_ENABLED=false
WATCH_POLL_SECONDS=15
GROUP_WINDOW_SECONDS=600
RESOLVE_AFTER_MINUTES=30
MAX_WATCHED_SERVICES=3
DEFAULT_CONFIDENCE_GATE=75
DEFAULT_MAX_ALERTS_PER_HOUR=6
LOG_LEVEL=INFO
ENV=development
